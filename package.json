{
  "name": "@corbits/reranking",
  "description": "Cross-encoder rerank client with TEI, Cohere/Jina and Voyage adapters, built on the Interchange inference primitives",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "homepage": "https://github.com/corbitsdev/corbits-reranking",
  "version": "0.1.0",
  "license": "LGPL-2.1-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@intx/inference": "^0.3.0",
    "@intx/log": "^0.3.0",
    "@intx/types": "^0.3.0",
    "arktype": "^2.1.29"
  },
  "devDependencies": {
    "@intx/inference-testing": "0.3.0",
    "@types/bun": "1.3.9",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-reranking.git"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-reranking/issues"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
